# Só precisa disso pra tela /discover (bônus — resto do app roda sem token).
# 1. Conta grátis: https://www.themoviedb.org/signup
# 2. Settings → API → Request API key (Developer)
# 3. A página mostra 2 chaves — cole QUALQUER uma das duas, o app detecta sozinho:
#    - "API Key" (v3, 32 caracteres hex, tipo a1b2c3d4...)
#    - "API Read Access Token" (v4, JWT longo, começa com eyJhbGc...)
VITE_TMDB_TOKEN=

# ── Firebase Remote Config (demo da Aula 3) — opcional, grátis (plano Spark) ──
# Banner no topo do app controlado pelo console do Firebase, sem novo deploy.
# Cole os valores do seu projeto (Console → ⚙ Configurações → Seus apps → app Web → firebaseConfig),
# ou os que o professor passar em aula. Sem eles, o app roda normal (sem banner).
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJjNjVlYzViOTJmODdmZjdiYTY3MDJkYzc2ZmIyMDlhOCIsIm5iZiI6MTc5MjYzODAyMS41NDQsInN1YiI6IjZhZDk3YzQ1YzcwNDcxZWM4MDg1YWI2NiIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.sv9pPW3ZGPAmMrkf19Pq9bkQhlFMd-1Mi7ni7Aw6etg
VITE_FIREBASE_APP_ID=
